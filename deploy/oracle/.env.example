# Public hostname only, without https:// or a path.
APP_DOMAIN=api.example.com
APP_HOST=api.example.com
DASHBOARD_ORIGIN=https://dashboard.example.com

RAILS_ENV=production
RAILS_MAX_THREADS=3
WEB_CONCURRENCY=0
DB_POOL=5
SOLID_QUEUE_IN_PUMA=true
SOLID_QUEUE_SUPERVISOR_MODE=async
JOB_THREADS=2
JOB_POLLING_INTERVAL=2
JOB_DISPATCH_INTERVAL=2
FORCE_SSL=true
RAILS_LOG_LEVEL=info

DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# MIGRATION: copy existing Render values exactly. Do not generate new keys.
SECRET_KEY_BASE=replace-with-existing-production-value
RAILS_MASTER_KEY=replace-with-existing-production-value
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=replace-with-existing-production-value
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=replace-with-existing-production-value
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=replace-with-existing-production-value

# Existing Neon accounts are retained. Do not run db:seed during migration.

MESSENGER_VERIFY_TOKEN=replace-with-existing-production-value
MESSENGER_APP_SECRET=replace-with-existing-production-value
# Page tokens are encrypted in Neon channel_connections; the global token is
# not a substitute for a business-specific Messenger connection.

GEMINI_API_KEY=replace-with-existing-production-value
GEMINI_MODEL=replace-with-existing-production-value
# Copy current CONVERSATION_*, CUSTOMER_PHOTO_RECOGNITION_* and KNOWLEDGE_*
# settings from Render when used. Do not change rollout values during migration.

# WhatsApp is optional until that channel is connected. If one is set, set all four.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
